{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user account profile for cloud sync.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "email": { "type": "string", "minLength": 3, "maxLength": 200 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "email", "createdAt", "updatedAt"]
    },
    "UIProjectDoc": {
      "title": "UIProjectDoc",
      "description": "Cloud-saved UI Workshop project metadata and screens.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "version": { "type": "string", "minLength": 1, "maxLength": 32 },
        "activeScreenId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "screens": { "type": "array" },
        "library": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "name", "version", "activeScreenId", "screens", "library", "createdAt", "updatedAt"]
    },
    "ArtDocumentDoc": {
      "title": "ArtDocumentDoc",
      "description": "Cloud-synced Art Studio illustration document metadata, strokes, and layer structure.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "dpi": { "type": "number" },
        "backgroundColor": { "type": "string", "minLength": 4, "maxLength": 32 },
        "layers": { "type": "array" },
        "palettes": { "type": "array" },
        "previewDataUrl": { "type": "string", "maxLength": 400000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "title", "width", "height", "dpi", "backgroundColor", "layers", "createdAt", "updatedAt"]
    },
    "SharedAssetDoc": {
      "title": "SharedAssetDoc",
      "description": "Shared ecosystem asset or sprite atlas usable across Art Studio and UI Workshop.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "sourceApp": { "type": "string", "enum": ["art_studio", "ui_workshop", "imported"] },
        "mimeType": { "type": "string", "minLength": 3, "maxLength": 64 },
        "dataUrl": { "type": "string", "maxLength": 500000 },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "isAtlas": { "type": "boolean" },
        "sprites": { "type": "array" },
        "robloxAssetId": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "name", "sourceApp", "mimeType", "dataUrl", "width", "height", "isAtlas", "sprites", "createdAt", "updatedAt"]
    },
    "BrushPackDoc": {
      "title": "BrushPackDoc",
      "description": "Custom Art Studio brush pack configuration.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "folder": { "type": "string", "minLength": 1, "maxLength": 64 },
        "formatVersion": { "type": "string", "minLength": 1, "maxLength": 16 },
        "brushes": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "name", "folder", "formatVersion", "brushes", "createdAt", "updatedAt"]
    },
    "TutorialProgressDoc": {
      "title": "TutorialProgressDoc",
      "description": "Tracks completed interactive Academy lessons per user.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "completedLessonIds": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "completedLessonIds", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner-only user profile and cloud account metadata."
    },
    "/ui_projects/{projectId}": {
      "schema": { "$ref": "#/entities/UIProjectDoc" },
      "description": "Cloud-saved UI Workshop projects owned by a user."
    },
    "/art_documents/{docId}": {
      "schema": { "$ref": "#/entities/ArtDocumentDoc" },
      "description": "Cloud-saved Art Studio documents owned by a user."
    },
    "/shared_assets/{assetId}": {
      "schema": { "$ref": "#/entities/SharedAssetDoc" },
      "description": "Shared sprite atlases, artwork exports, and textures owned by a user."
    },
    "/brush_packs/{packId}": {
      "schema": { "$ref": "#/entities/BrushPackDoc" },
      "description": "Custom brush packs created or imported by a user."
    },
    "/tutorial_progress/{userId}": {
      "schema": { "$ref": "#/entities/TutorialProgressDoc" },
      "description": "Per-user Academy lesson completion state."
    }
  }
}
